            <TabItem FontSize="20">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource FloorIcon}" Height="35" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Этажи" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10 0"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Floors, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedFloor}" Grid.RowSpan="4" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <!--<Label Content="Этаж: " Foreground="{StaticResource ForeColor}" FontSize="28"/>-->
                                    <TextBlock Text="{Binding FloorNumber, StringFormat=Этаж: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedFloor}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Этаж"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5 5 5 0" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 0 5 0">
                                <Label Content="Номер: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Кол-во комнат : " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding TotalRoomsNumber}" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddFloorButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddFloorButton_Click"/>
                        <Button Command="{Binding RemoveFloorCommand}" x:Name="DeleteFloorButton" Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>

                    <!--<Button Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="10 20 10 10"
                            Content="Запросы"/>-->
                </Grid>
            </TabItem>

            <TabItem FontSize="20">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource RoomIcon}" Height="35" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Номера" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10 0"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ItemsSource="{Binding Rooms, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedRoom}" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <!--<Label Content="Комната № " Foreground="{StaticResource ForeColor}" FontSize="28"/>-->
                                    <TextBlock Text="{Binding RoomNumber, StringFormat= Комната № {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedRoom}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Комната"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5 5 5 0" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 0 5 0">
                                <Label Content="Номер: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding RoomNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Этаж: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Floor.FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Тип: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding RoomType}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Вместимость: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Capacity}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Свободно мест: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FreePlaces}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Цена: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PricePerNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Забронирован: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding IsBooked}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Доступен: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding IsAvailable}" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddNumberButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddNumberButton_Click"/>
                        <Button Command="{Binding RemoveRoomCommand}" Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem FontSize="20">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource EmployeeIcon}" Height="35" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Сотрудники" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10 0"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ItemsSource="{Binding Employees, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedEmployee}" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <TextBlock Text="{Binding LastName, StringFormat=Сотрудник {0}}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource ForeColor}" FontSize="28" MaxWidth="315" MinWidth="315" TextTrimming="CharacterEllipsis" Margin="5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedEmployee}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Сотрудник"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5 5 5 0" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 0 5 0">
                                <Label Content="Фамилия: " FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastName}" Foreground="{StaticResource BackColor}" VerticalAlignment="Center" FontSize="28" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Имя: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FirstName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Отчество: " FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MiddleName}" Foreground="{StaticResource BackColor}" VerticalAlignment="Center" FontSize="28" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Телефон: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PhoneNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Статус: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Status}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Текущий этаж: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding CurrentFloor.FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                            <Label Content="День уборки: " FontSize="28" FontWeight="Bold"/>
                            <Label Content="{Binding CleaningDay}" FontSize="28"/>
                            </DockPanel>

                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddEmployeeButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddEmployeeButton_Click"/>
                        <Button Command="{Binding RemoveEmployeeCommand}" Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>

                    <Button x:Name="EmployeeQueryButtonClick" Content="Запросы" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="10 20 10 10" Click="EmployeeQueryButtonClick_Click"/>
                </Grid>
            </TabItem>

            <TabItem FontSize="20">
                <TabItem.Header >
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource ClientIcon}" Height="35" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Клиенты" VerticalAlignment="Center" FontWeight="Bold" Margin="10 0"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource ForeColor}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="28" MaxWidth="280" MinWidth="280" TextTrimming="CharacterEllipsis" Margin="10">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="LastName"/>
                                            <Binding Path="FirstName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedClient}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Клиент"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5 5 5 0" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 0 5 0">
                                <Label Content="Фамилия: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding LastName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Имя: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FirstName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Отчество: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding MiddleName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Телефон: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PhoneNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="E-mail: " FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Email}" Foreground="{StaticResource BackColor}" FontSize="28" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Город: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding City}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Комната: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding BookedRoom.RoomNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Прибытие: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding ArrivalDate}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Выезд: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding CheckOutDate}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Внесённая сумма: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PayedAmount}" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10"/>
                        <Button Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>

                    <Button x:Name="QueryButtonClick" Content="Запросы" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="10 20 10 10" Click="QueryButtonClick_Click"/>
                </Grid>
            </TabItem>

            <TabItem FontSize="20">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource InfoIcon}" Height="35" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Инфо" VerticalAlignment="Center" FontWeight="Bold" Margin="10 0"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
                            Background="{StaticResource ForeColor}" CornerRadius="15" Margin="10">
                        <DockPanel Margin="10">
                            <Image Source="{StaticResource MoneyIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel>
                                <Label Content="Общая выплаченная клиентами сумма" Foreground="{StaticResource BackColor}" FontSize="32" Margin="15"/>
                                <TextBlock Text="{Binding TotalPayedAmount, StringFormat={}{0} руб., Mode=OneWay}" Foreground="{StaticResource BackColor}" FontSize="40"  FontWeight="Bold" Margin="15 5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                            Background="{StaticResource ControlsPressColor}" CornerRadius="15" Margin="10">
                        <DockPanel Margin="15">
                            <Image Source="{StaticResource FreeRoomsIcon}" Height="100" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel>
                                <Label Content="Свободных номеров" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="10 20 5 5"/>
                                <TextBlock Text="{Binding TotalFreeRoomsAmount, StringFormat={}{0}, Mode=OneWay}" Foreground="{StaticResource ForeColor}" FontSize="36"  FontWeight="Bold" Margin="15 5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="2"
                            Background="{StaticResource ControlsPressColor}" CornerRadius="15" Margin="10">
                        <DockPanel Margin="15">
                            <Image Source="{StaticResource BedIcon}" Height="100" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel>
                                <Label Content="Свободных мест" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="10 20 10 5"/>
                                <TextBlock Text="{Binding TotalFreePlacesAmount, StringFormat={}{0}, Mode=OneWay}" Foreground="{StaticResource ForeColor}" FontSize="36"  FontWeight="Bold" Margin="15 5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
                            Background="{StaticResource BackColor}" CornerRadius="15" Margin="10">
                        <DockPanel Margin="15">
                            <Image Source="{StaticResource PriceIcon}" Height="150" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel>
                                <TextBlock Text="Цена за одно место" Foreground="{StaticResource ForeColor}" FontSize="32" Margin="15 15 15 0" TextWrapping="Wrap"/>
                                <DockPanel Margin="15 0">
                                    <Label Content="В" FontSize="28" Foreground="{StaticResource ForeColor}"/>
                                    <TextBox Text="{Binding InfoRoomNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="70" FontSize="28" Margin="15 0"/>
                                    <Label Content="комнате на" FontSize="28" Foreground="{StaticResource ForeColor}"/>
                                    <TextBox Text="{Binding InfoFloorNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="70" FontSize="28" Margin="15 0"/>
                                    <Label Content="этаже" FontSize="28" Foreground="{StaticResource ForeColor}"/>
                                    <Button Command="{Binding GetPriceCommand}" Content="Вычислить" HorizontalAlignment="Right" FontSize="24" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="{Binding PriceForOnePlace, StringFormat={}{0} руб., Mode=OneWay}" Foreground="{StaticResource ForeColor}" FontSize="40"  FontWeight="Bold" Margin="15 5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
