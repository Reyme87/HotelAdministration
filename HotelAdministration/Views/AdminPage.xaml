<Page x:Class="HotelAdministration.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"  FontFamily="{StaticResource MainFont}"
      Title="AdminPage">

    <Page.Resources>
        <ResourceDictionary/>
    </Page.Resources>

    <Page.DataContext>
        <vm:ManageViewModel/>
    </Page.DataContext>
    
    <Grid Background="{StaticResource BackColor}">
        <TabControl Background="{StaticResource ControlsColor}" TabStripPlacement="Top">
            <!--<TabItem Header="Профиль" FontSize="20">
