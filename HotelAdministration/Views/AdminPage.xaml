<Page x:Class="HotelAdministration.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"  FontFamily="{StaticResource MainFont}"
      Title="AdminPage">

    <Page.Resources>
        <ResourceDictionary/>
    </Page.Resources>

    <Page.DataContext>
        <vm:ManageViewModel/>
    </Page.DataContext>
    
    <Grid Background="{StaticResource BackColor}">
        <TabControl Background="{StaticResource ControlsColor}">
            <TabItem Header="Профиль" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Профиль администратора"
                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="36"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Фамилия" FontSize="26"
                       VerticalAlignment="Top" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                         VerticalAlignment="Top" Margin="30 10"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Имя" FontSize="26"
                       VerticalAlignment="Center" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                       VerticalAlignment="Center" Margin="30 10"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Отчество" FontSize="26"
                       VerticalAlignment="Bottom" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                         VerticalAlignment="Bottom" Margin="30 10"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="e-mail" FontSize="26"
                       VerticalAlignment="Top" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                         VerticalAlignment="Top" Margin="30 10"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Телефон" FontSize="26"
                       VerticalAlignment="Center" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                       VerticalAlignment="Center" Margin="30 10"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Логин" FontSize="26"
                       VerticalAlignment="Bottom" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                       VerticalAlignment="Bottom" Margin="30 10" IsReadOnly="True"/>

                    <Button Grid.Row="3" Grid.Column="1" Content="Сохранить" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>

            <TabItem Header="Этажи" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Floors, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedFloor}" Grid.RowSpan="4" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <Label Content="Этаж: " Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                    <Label Content="{Binding FloorNumber}" Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedFloor}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Этаж"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Номер: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Кол-во комнат : " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding TotalRoomsNumber}" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddFloorButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddFloorButton_Click"/>
                        <Button x:Name="DeleteFloorButton" Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Номера" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ItemsSource="{Binding Rooms, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedRoom}" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <Label Content="Комната № " Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                    <Label Content="{Binding RoomNumber}" Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedRoom}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Комната"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Номер: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding RoomNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Этаж: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Floor.FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Тип: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding RoomType}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Вместимость: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Capacity}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Свободно мест: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FreePlaces}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Цена: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PricePerNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Забронирован: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding IsBooked}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Доступен: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding IsAvailable}" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddNumberButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddNumberButton_Click"/>
                        <Button Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Сотрудники" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ItemsSource="{Binding Employees, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedEmployee}" Margin="10 10 10 60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10 5">
                                    <Label Content="Сотрудник" Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                    <Label Content="{Binding LastName}" Foreground="{StaticResource ForeColor}" FontSize="28"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel DataContext="{Binding SelectedEmployee}">
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Сотрудник"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Фамилия: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding LastName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Имя: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding FirstName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Отчество: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding MiddleName}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Телефон: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding PhoneNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Статус: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding Status}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Текущий этаж: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="{Binding CurrentFloor.FloorNumber}" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                            <Label Content="День уборки: " FontSize="28" FontWeight="Bold"/>
                            <Label Content="{Binding CleaningDay}" FontSize="28"/>
                            </DockPanel>

                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="AddEmployeeButton" Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10" Click="AddEmployeeButton_Click"/>
                        <Button Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Клиенты" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Margin="10 10 10 60"/>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">
                        <StackPanel>
                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Клиент"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5" FontSize="36" FontWeight="Bold"/>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Фамилия: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="Сергеев" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Имя: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="Сергей" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Отчество: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="Сергеевич" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Телефон: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="+88005553535" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="E-mail: " FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="babababebebe@mail.ru" FontSize="28" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Город: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="Тамбоу" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Комната: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="2" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Прибытие: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="02/10/25" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Выезд: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="12/10/25" FontSize="28"/>
                            </DockPanel>
                            <DockPanel Margin="5 5 5 0">
                                <Label Content="Внесённая сумма: " FontSize="28" FontWeight="Bold"/>
                                <Label Content="12500" FontSize="28"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="0" Grid.Row="3" VerticalAlignment="Bottom">
                        <Button Content="Добавить" Width="150" HorizontalAlignment="Left" Margin="10 20 0 10"/>
                        <Button Content="Удалить" Width="150" HorizontalAlignment="Right" Margin="0 20 10 10"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
