<Window x:Class="HotelAdministration.Views.EmployeesQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelAdministration.Views"
        xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
        mc:Ignorable="d"
        Title="EmployeesQueryWindow" Height="700" Width="900" FontFamily="{StaticResource MainFont}" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.Resources>
        <ResourceDictionary/>
    </Window.Resources>

    <Window.DataContext>
        <vm:ManageViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
            Content="{StaticResource BackArrow}" FontWeight="Bold" x:Name="NavigationButton" Click="NavigationButton_Click"/>

        <Rectangle Grid.Row="1" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="6" Fill="{StaticResource ControlsColor}"/>

        <Label Content="Сотрудник" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Foreground="{StaticResource ForeColor}" FontSize="36" FontWeight="Bold"
           VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="10" CornerRadius="15" Background="{StaticResource BackColor}">
            <StackPanel>
                <DockPanel Margin="0 15 0 0" HorizontalAlignment="Center">
                    <TextBlock Text="Сотрудник, убиравший номер клиента в заданный день недели" Foreground="{StaticResource ForeColor}" FontSize="28" VerticalAlignment="Top" Margin="15 5"/>
                </DockPanel>

                <DockPanel Margin="15 0 15 5" HorizontalAlignment="Center">
                    <TextBlock Text="Клиент: " Foreground="{StaticResource ForeColor}" FontSize="28" VerticalAlignment="Top" Margin="15"/>
                    <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding QueryClient}" Width="200" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Label Foreground="{StaticResource BackColor}" Content="{Binding LastName}" FontSize="24"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                
                <DockPanel Margin="38 0 15 5" HorizontalAlignment="Center">
                    <TextBlock Text="День: " Foreground="{StaticResource ForeColor}" FontSize="32" VerticalAlignment="Top" Margin="15"/>
                    <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding QueryDay}" Width="200" Height="40" FontSize="24" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10"/>
                </DockPanel>
                
                <Button Command="{Binding FindEmployeeByDayCommand}" Content="Поиск" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120" Margin="10 15 10 0"/>
            </StackPanel>
        </Border>

        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="Информация о сотруднике"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"/>

        <Border DataContext="{Binding MatchingEmployee}" Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" 
                Background="{StaticResource ControlsPressColor}" CornerRadius="15" Margin="10">
            <DockPanel Margin="10">
                <StackPanel>
                    <TextBlock Text="{Binding LastName, StringFormat=Фамилия: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding FirstName, StringFormat=Имя: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="00 0 0 0">
                    <TextBlock Text="{Binding PhoneNumber, StringFormat=Телефон: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding CurrentFloor.FloorNumber, StringFormat=Этаж: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="00 0 0 0">
                    <TextBlock Text="{Binding CleaningDay, StringFormat=День уборки: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding Status, StringFormat=Статус: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding EmployeesVisibilityParam}" HorizontalAlignment="Center">
            <Image Source="{StaticResource SearchErrorIcon}" Height="80" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Label Content="К сожалению, не удалось найти сотрудника" FontSize="32" Foreground="{StaticResource ForeColor}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"/>
        </DockPanel>

    </Grid>
</Window>
