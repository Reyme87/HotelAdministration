<Page x:Class="HotelAdministration.Views.AddNumberPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800" FontFamily="{StaticResource MainFont}"
      Title="AddNumberPage">

    <Grid Background="{StaticResource ControlsColor}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.ColumnSpan="3" Content="Добавление данных о комнате" FontSize="28" FontWeight="Bold"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="1" Content="Номер" FontSize="24" FontWeight="Bold"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="2" Content="Этаж" FontSize="24" FontWeight="Bold"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="3" Content="Вместимость" FontSize="24" FontWeight="Bold"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="4" Content="Цена" FontSize="24" FontWeight="Bold"
           VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" FontSize="22"
         VerticalAlignment="Center" Height="35" Margin="5"/>
        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" FontSize="22" 
         VerticalAlignment="Center" Height="35" Margin="5"/>
        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3" FontSize="22" 
         VerticalAlignment="Center" Height="35" Margin="5"/>
        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="4" FontSize="22" 
         VerticalAlignment="Center" Height="35" Margin="5"/>

        <Button Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="6" Content="Добавить" 
                Width="160" VerticalAlignment="Bottom" Margin="0 25"/>
        <Button x:Name="ReturnButton" Content="{StaticResource BackArrow}" Width="40" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Click="ReturnButton_Click"/>
    </Grid>
</Page>
