<Page x:Class="HotelAdministration.Views.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="600" FontFamily="{StaticResource MainFont}"
      Title="AuthPage">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" 
                Content="{StaticResource BackArrow}" FontWeight="Bold" x:Name="NavigationButton" Click="NavigationButton_Click"/>

        <Image Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Source="{StaticResource BackgroundImage}" Stretch="Fill" />

        <!--<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Fill="{StaticResource ControlsColor}" />-->

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
               Content="Пройдите авторизацию" Foreground="{StaticResource BackColor}" FontSize="32" FontWeight="Bold"
               VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel VerticalAlignment="Top">
                <Label Content="Логин/e-mail" 
                       Foreground="{StaticResource BackColor}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Top" Margin="130 10"/>
                <TextBox Height="35" Width="350" 
                         VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="24" BorderThickness="2"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <Label Content="Пароль" 
                       Foreground="{StaticResource BackColor}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Bottom" Margin="130 10"/>
                <TextBox Height="35" Width="350"  FontSize="24" BorderThickness="2"/>
                
            </StackPanel>
        </StackPanel>
       

        <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Content="Войти"  FontSize="24" FontWeight="Bold"
        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="25" x:Name="AuthButton"/>
        
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="Или зарегистрируйте новый аккаунт" FontWeight="Bold"
               Foreground="{StaticResource ForeColor}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="45"/>
        <Button Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Content="Зарегистрироваться"  FontSize="20" FontWeight="Bold"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" x:Name="RegButton" Click="RegButton_Click"/>

    </Grid>
</Page>
