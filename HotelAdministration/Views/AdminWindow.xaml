<Window x:Class="HotelAdministration.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelAdministration.Views"
        mc:Ignorable="d"
        Title="AdminWindow" Height="600" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <ResourceDictionary/>
    </Window.Resources>
    
    <Grid Background="{StaticResource BackColor}">
        <TabControl Background="{StaticResource ControlsColor}">
            <TabItem Header="Профиль" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Профиль администратора"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="36"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Content="Фамилия" FontSize="26"
                           VerticalAlignment="Top" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                             VerticalAlignment="Top" Margin="30 10"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Content="Имя" FontSize="26"
                           VerticalAlignment="Center" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                           VerticalAlignment="Center" Margin="30 10"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Content="Отчество" FontSize="26"
                           VerticalAlignment="Bottom" Margin="15 10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                             VerticalAlignment="Bottom" Margin="30 10"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="e-mail" FontSize="26"
                           VerticalAlignment="Top" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                             VerticalAlignment="Top" Margin="30 10"/>
                    
                    <Label Grid.Row="2" Grid.Column="0" Content="Телефон" FontSize="26"
                           VerticalAlignment="Center" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                           VerticalAlignment="Center" Margin="30 10"/>
                    
                    <Label Grid.Row="2" Grid.Column="0" Content="Логин" FontSize="26"
                           VerticalAlignment="Bottom" Margin="15 10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="35"
                           VerticalAlignment="Bottom" Margin="30 10" IsReadOnly="True"/>

                    <Button Grid.Row="3" Grid.Column="1" Content="Сохранить" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Этажи" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Margin="10"/>
                </Grid>
            </TabItem>

            <TabItem Header="Номера" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
            
            <TabItem Header="Сотрудники" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
            
            <TabItem Header="Клиенты" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
