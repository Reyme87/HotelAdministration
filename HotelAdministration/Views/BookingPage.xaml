<Page x:Class="HotelAdministration.Views.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
      mc:Ignorable="d"
      Language="ru-RU"
      d:DesignHeight="800" d:DesignWidth="1000" FontFamily="{StaticResource MainFont}"
      Title="BookingPage">

    <Page.Resources>
        <ResourceDictionary/>
    </Page.Resources>

    <Page.DataContext>
        <vm:GuestViewModel/>
    </Page.DataContext>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.6*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" 
                Content="{StaticResource BackArrow}" FontWeight="Bold" x:Name="NavigationButton" Click="NavigationButton_Click"/>

        <Rectangle Grid.Row="1" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="6" Fill="{StaticResource ControlsColor}"/>

        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" 
               Content="Бронирование комнаты" Foreground="{StaticResource BackColor}" FontSize="36" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 15"/>
        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" 
               Content="Информация о комнате" Foreground="{StaticResource BackColor}" FontSize="28" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 10"/>

        <Border DataContext="{Binding SelectedRoomBooking}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" 
                 Background="{StaticResource ControlsPressColor}" CornerRadius="15" Margin="10">
            <DockPanel Margin="10">
                <StackPanel>
                    <TextBlock Text="{Binding RoomType, StringFormat=Тип: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding Capacity, StringFormat=Вместимость: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="00 0 0 0">
                    <TextBlock Text="{Binding FloorId, StringFormat=Этаж: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding RoomNumber, StringFormat=Номер: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="00 0 0 0">
                    <TextBlock Text="{Binding IsAvailable, StringFormat=Свободен: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                    <TextBlock Text="{Binding PricePerNumber, StringFormat=Цена: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="00 0 0 0">
                    <TextBlock Text="{Binding DataContext.PriceForOnePlace, RelativeSource={RelativeSource AncestorType=Grid}, StringFormat=Стоимость места: {0}}" Foreground="{StaticResource ForeColor}" FontSize="26" Margin="15" TextWrapping="Wrap"/>
                    <!--<DockPanel>-->
                        <!--<TextBlock Text="{Binding PricePerNumber, StringFormat=Цена: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>-->
                    <Button Command="{Binding DataContext.CalculatePriceCommand, RelativeSource={RelativeSource AncestorType=Grid}}" Content="Вычислить" Width="140" FontSize="24" Height="40" HorizontalAlignment="Center" Margin="15"/>
                    <!--</DockPanel>-->
                    
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="Добавление данных о клиенте" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ScrollViewer Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl >
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Фамилия" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="85 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Имя" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="131 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Отчество" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="88 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Номер телефона" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="18 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Email" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="122 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Город" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="118 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Дата заселения" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <DatePicker Text="{Binding CheckInDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="30 0"/>
                    </DockPanel>
                    <DockPanel Margin="10 10 10 5">
                        <Label Content="Дата отъезда" FontSize="20" Foreground="{StaticResource ForeColor}"/>
                        <DatePicker Text="{Binding CheckOutDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300" HorizontalAlignment="Left" Margin="53 0"/>
                    </DockPanel>
                </ItemsControl>
            </ScrollViewer>
            <Button Command="{Binding AddClientCommand}" Grid.Row="1" Grid.Column="3" Content="+" FontSize="24" FontWeight="Bold" Height="40" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="30 15"/>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Grid.RowSpan="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="Список клиентов" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ListBox ItemsSource="{Binding Clients, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedItem="{Binding SelectedClient, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="24" Margin="10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="LastName"/>
                                    <Binding Path="FirstName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Command="{Binding RemoveClientCommand}" Grid.Row="1" Grid.Column="3" Content="-" FontSize="24" FontWeight="Bold" Height="40" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"/>
        </Grid>

        <Button Command="{Binding BookRoomCommand}" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="Забронировать" FontWeight="Bold" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
