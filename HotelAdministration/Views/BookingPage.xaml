<Page x:Class="HotelAdministration.Views.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000" FontFamily="{StaticResource MainFont}"
      Title="BookingPage">

    <Page.Resources>
        <ResourceDictionary/>
    </Page.Resources>

    <Page.DataContext>
        <vm:GuestViewModel/>
    </Page.DataContext>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.6*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" 
                Content="{StaticResource BackArrow}" FontWeight="Bold" x:Name="NavigationButton" Click="NavigationButton_Click"/>

        <Rectangle Grid.Row="1" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="6" Fill="{StaticResource ControlsColor}"/>

        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" 
               Content="Бронирование комнаты" Foreground="{StaticResource BackColor}" FontSize="36" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 15"/>
        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" 
               Content="Информация о комнате" Foreground="{StaticResource BackColor}" FontSize="28" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 10"/>

        <Border DataContext="{Binding SelectedRoomBooking}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" 
                 Background="{StaticResource ControlsPressColor}" CornerRadius="15" Margin="10">
            <DockPanel Margin="10">
                <StackPanel>
                    <TextBlock Text="{Binding RoomType, StringFormat=Тип: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                    <TextBlock Text="{Binding Capacity, StringFormat=Вместимость: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="100 0 0 0">
                    <TextBlock Text="{Binding FloorId, StringFormat=Этаж: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                    <TextBlock Text="{Binding RoomNumber, StringFormat=Номер: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                </StackPanel>
                <StackPanel Margin="100 0 0 0">
                    <TextBlock Text="{Binding IsAvailable, StringFormat=Свободен: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                    <TextBlock Text="{Binding PricePerNumber, StringFormat=Цена: {0}}" Foreground="{StaticResource ForeColor}" FontSize="28" Margin="15"/>
                </StackPanel>
            </DockPanel>
         </Border>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="Добавление данных о клиенте" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ListView Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="4">
                <DockPanel>
                    <Label Content="Фамилия" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Имя" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Отчество" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Номер телефона" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Email" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Город" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Дата заселения" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <DatePicker Text="{Binding CheckInDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
                <DockPanel>
                    <Label Content="Дата отъезда" FontSize="20" Foreground="{StaticResource BackColor}"/>
                    <DatePicker Text="{Binding CheckOutDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="20" MinWidth="160" MaxWidth="300"/>
                </DockPanel>
            </ListView>

            <Button Grid.Row="1" Grid.Column="3" Content="+" FontSize="24" FontWeight="Bold" Height="40" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"/>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Grid.RowSpan="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="Список клиентов" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <ListBox Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="4">

            </ListBox>

            <Button Grid.Row="1" Grid.Column="3" Content="-" FontSize="24" FontWeight="Bold" Height="40" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"/>
        </Grid>
        

        <Button Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="Забронировать" FontWeight="Bold" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
