<Window x:Class="HotelAdministration.Views.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelAdministration.Views"
        mc:Ignorable="d"
        Title="GuestWindow" Height="800" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <ResourceDictionary/>
    </Window.Resources>
    
    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" 
                Content="{StaticResource BackArrow}" FontWeight="Bold" x:Name="NavigationButton" Click="NavigationButton_Click"/>
        
        <Rectangle Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="4" Fill="{StaticResource ControlsColor}"/>

        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="4" Margin="15" Padding="15 0" CornerRadius="15" Background="{StaticResource ControlsPressColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <DockPanel VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                    <Button Height="40" Width="40" HorizontalAlignment="Left" Content="&lt;"/>
                    <Button Height="40" Width="40" HorizontalAlignment="Right" Content="&gt;"/>
                </DockPanel>

                <Button Grid.Row="2" Grid.Column="1" Content="Посмотреть" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Номера в категории:" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BackColor}"
               VerticalAlignment="Top" Margin="15 5 0 0"/>
        <ListBox Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="4" Margin="15 40 15 15">
        </ListBox>
    </Grid>
</Window>
