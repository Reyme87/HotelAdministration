<Page x:Class="HotelAdministration.Views.AddFloorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      xmlns:vm="clr-namespace:HotelAdministration.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="900" FontFamily="{StaticResource MainFont}"
      Title="AddFloorPage">

    <Page.DataContext>
        <vm:ManageViewModel/>
    </Page.DataContext>
    
    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="100"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.ColumnSpan="3" Content="Добавление данных об этаже" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ForeColor}"
               VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Image Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="5" Source="{StaticResource BackgroundImage}" Stretch="Fill" />
        
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="2" VerticalAlignment="Center" Margin="15">
            <Label Grid.Column="1" Grid.Row="1" Content="Номер" FontSize="24" FontWeight="DemiBold" Foreground="{StaticResource BackColor}"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 15 10 5"/>
            <TextBox Text="{Binding FloorNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" FontSize="22"
                     VerticalAlignment="Center" Height="35" Margin="5"/>

            <Label Content="Кол-во комнат" FontSize="24" FontWeight="DemiBold" Foreground="{StaticResource BackColor}"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 65 10 5"/>
            <TextBox Text="{Binding TotalRooms, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" FontSize="22" 
                     VerticalAlignment="Center" Height="35" Margin="5"/>
        </StackPanel>
        

        <Button Command="{Binding AddFloorCommand}" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="6" Content="Добавить" 
                Width="160" VerticalAlignment="Center"/>
        <Button x:Name="ReturnButton" Content="{StaticResource BackArrow}" Width="40" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Click="ReturnButton_Click"/>
    </Grid>
</Page>
