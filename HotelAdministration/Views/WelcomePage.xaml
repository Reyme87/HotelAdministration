<Page x:Class="HotelAdministration.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelAdministration.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="600" FontFamily="Britannic Bold"
      Title="WelcomePage">

    <Page.Resources>
        <ResourceDictionary />
    </Page.Resources>
    
    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{StaticResource BackColor}">
            <Image Source="{StaticResource IntroImage}" Stretch="Fill">
                <Image.Effect>
                    <BlurEffect Radius="5"/>
                </Image.Effect>
            </Image>
        </Border>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource BackColor}">
            <Label Content="LOGO" Foreground="{StaticResource ForeColor}" HorizontalAlignment="Center" FontSize="50" VerticalAlignment="Center"/>
        </Border>

        <Rectangle Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Fill="{StaticResource BackColor}" Opacity="0.6"/>

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Добро пожаловать!"
        Foreground="{StaticResource ForeColor}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="35" FontWeight="Bold"/>

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Выберите ваш профиль"
        Foreground="{StaticResource ForeColor}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="50" FontWeight="Bold"/>

        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Content="Администратор" FontWeight="Bold" Height="50" Width="250" Click="Button_Click"/>
        <Button x:Name="GuestButton" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Content="Гость" FontWeight="Bold" Height="50" Width="250" Click="GuestButton_Click"/>
    </Grid>
</Page>
